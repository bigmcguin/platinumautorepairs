# Protects files that must never be public. Do not remove.
# Hostinger copies the whole repository into public_html, so these rules
# stop visitors reading CLAUDE.md, the .claude/ folder, .git and any other
# hidden file or folder. Requests for them get a plain 404.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_alias.c>
  # Any path segment starting with a dot (.git, .claude, .htaccess, .gitkeep),
  # except .well-known/, which is needed for SSL certificate checks.
  RedirectMatch 404 (?i)(^|/)\.(?!well-known(/|$))
  # Claude's project instructions
  RedirectMatch 404 (?i)(^|/)CLAUDE\.md$
</IfModule>

# Fallback if mod_alias is unavailable: refuse access instead.
<IfModule !mod_alias.c>
  <FilesMatch "(?i)^(CLAUDE\.md|\..+)$">
    Require all denied
  </FilesMatch>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F]
</IfModule>

# ----------------------------------------------------------------------
# Speed: compression and browser caching.
# Pages are always rechecked so updates show straight away. CSS and JS
# are kept for a day (file names do not change between updates). Fonts
# and images are kept for a year: give a replaced image a new file name.
# ----------------------------------------------------------------------

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript image/svg+xml image/x-icon
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
